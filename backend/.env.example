# MongoDB Atlas connection string (database name: estatesathi)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/estatesathi?retryWrites=true&w=majority
# Koi bhi lamba random text
JWT_SECRET=koi-bhi-lamba-random-secret-likh-do
# App login ka userid aur password (server start hone par database me ban jata hai)
ADMIN_USER=owner
ADMIN_PASS=1234
PORT=5000
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Optional folder for uploaded images
IMAGEKIT_FOLDER=/estate-sathi
